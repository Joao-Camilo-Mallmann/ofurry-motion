{
  "name": "ofurry-motion",
  "version": "1.0.0",
  "description": "Motion Design para o canal do OFurry powered by Remotion & Bun",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts OFurryComposition out/video.mp4",
    "render:sample": "remotion render src/index.ts OFurryComposition out/sample.mp4",
    "render:coe": "remotion render src/index.ts COEComposition out/coe-intro.mp4",
    "render:full": "remotion render src/index.ts COEComposition out/coe-full.mp4",
    "render:bloco3": "remotion render src/index.ts KineticBloco3-Full-38s out/bloco3-full.mp4",
    "render:bloco3:webm": "remotion render src/index.ts KineticBloco3-Full-38s out/bloco3-full.webm --pixel-format=yuva420p --codec=vp9 --image-format=png",
    "render:bloco3:prores": "remotion render src/index.ts KineticBloco3-Full-38s out/bloco3-full.mov --pixel-format=yuva444p10le --codec=prores --prores-profile=4444 --image-format=png",
    "render:scenes": "bun run scripts/render-scenes.ts --format=prores",
    "render:scenes:webm": "bun run scripts/render-scenes.ts --format=webm",
    "render:scenes:mp4": "bun run scripts/render-scenes.ts --format=mp4",
    "render:scene": "bun run scripts/render-scenes.ts",
    "render:video": "bun run scripts/render-scenes.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "lucide-react": "^1.37.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.518",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.518",
    "@remotion/cli": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  }
}
