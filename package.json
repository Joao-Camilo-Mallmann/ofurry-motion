{
  "name": "animation-to-yt",
  "version": "1.0.0",
  "description": "OFurry YouTube Motion Graphics Engine powered by Remotion",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts OFurryComposition out/video.mp4",
    "render:sample": "remotion render src/index.ts OFurryComposition out/sample.mp4",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.1.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.233",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.233",
    "@remotion/cli": "^4.0.233",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
